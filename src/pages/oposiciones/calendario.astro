---
// Calendario vivo: se edita en src/data/calendario.json (o desde el editor Pages CMS).
import Base from '../../layouts/Base.astro';
import Intro from '../../components/Intro.astro';
import Icono from '../../components/Icono.astro';
import Borrador from '../../components/Borrador.astro';
import calendario from '../../data/calendario.json';
import { fecha } from '../../lib/formatos';
import { ruta } from '../../lib/rutas';

type Evento = {
  orden: string;
  cuando: string;
  titulo: string;
  detalle: string;
  estado: 'confirmado' | 'previsto' | 'sin-confirmar';
  fuente_nombre: string;
  fuente_url: string;
};

const estados = {
  confirmado: { nombre: 'Confirmado', descripcion: 'Publicado en una fuente oficial o en prensa con fecha.' },
  previsto: { nombre: 'Previsto', descripcion: 'Anunciado o repetido cada año, pero sin fecha oficial.' },
  'sin-confirmar': { nombre: 'Sin confirmar', descripcion: 'Cálculo propio o dato que falta contrastar.' },
} as const;

const eventos = (calendario.eventos as Evento[]).slice().sort((a, b) => a.orden.localeCompare(b.orden));
---

<Base
  titulo="Calendario de oposiciones de Maestros en Murcia"
  descripcion="Fechas clave de las oposiciones de Maestros en la Región de Murcia, con su fuente y su grado de certeza."
>
  <Intro
    titulo="Calendario de oposiciones"
    entradilla="Las fechas que importan para opositar a Maestros en la Región de Murcia. Cada una dice de dónde sale y si está confirmada."
    camino={[{ texto: 'Oposiciones', enlace: '/oposiciones/' }, { texto: 'Calendario' }]}
  >
    <p class="revisado">
      <Icono nombre="reloj" />
      Revisado el {fecha(new Date(calendario.revisado))}
    </p>
  </Intro>

  <div class="contenedor calendario">
    <div class="calendario__leyenda" aria-labelledby="titulo-leyenda">
      <h2 id="titulo-leyenda" class="calendario__leyenda-titulo">Cómo leerlo</h2>
      <ul>
        {
          Object.entries(estados).map(([clave, e]) => (
            <li>
              <span class={`estado estado--${clave}`}>{e.nombre}</span>
              {e.descripcion}
            </li>
          ))
        }
      </ul>
    </div>

    <ol class="linea" data-linea>
      {
        eventos.map((ev) => (
          <li class={`hito hito--${ev.estado}`} data-orden={ev.orden}>
            <p class="hito__cuando">
              {ev.cuando}
              <span class={`estado estado--${ev.estado}`}>{estados[ev.estado].nombre}</span>
              <span class="hito__pasado" hidden data-pasado>
                Ya pasó
              </span>
            </p>
            <h2 class="hito__titulo">{ev.titulo}</h2>
            <p class="hito__detalle">{ev.detalle}</p>
            <p class="hito__fuente">
              Fuente:{' '}
              {ev.fuente_url ? <a href={ev.fuente_url}>{ev.fuente_nombre}</a> : <span>{ev.fuente_nombre}</span>}
            </p>
          </li>
        ))
      }
    </ol>

    <section class="vigilar" aria-labelledby="titulo-vigilar">
      <h2 id="titulo-vigilar">Qué vigilamos cada mes</h2>
      <ul>
        <li>
          El Boletín Oficial de la Región de Murcia (BORM) y la web de{' '}
          <a href="https://rrhheducacion.carm.es">Recursos Humanos de Educación</a>: la oferta de empleo de 2026 y
          cuántas plazas trae para Maestros.
        </li>
        <li>La Mesa Sectorial de Educación de Murcia: calendario de 2028 y cambios en las bases.</li>
        <li>
          La reforma estatal del Reglamento de ingreso (Real Decreto 276/2007): borradores, temarios nuevos y desde
          qué convocatoria se aplicarían.
        </li>
        <li>Las plazas que quedan desiertas en Maestros y la tasa de interinidad.</li>
      </ul>
      <p>
        <Borrador />
        ¿Has visto una fecha que no está aquí? Escríbenos a <a href="mailto:hola@ideducando.es">hola@ideducando.es</a>{' '}
        con el enlace y la revisamos.
      </p>
      <p><a href={ruta('/oposiciones/')}>Volver a Oposiciones</a></p>
    </section>
  </div>
</Base>

<script>
  // Marca como pasados los hitos con fecha anterior a hoy. Se calcula en tu navegador,
  // así que siempre está al día aunque la web no se haya vuelto a publicar.
  const hoy = new Date().toISOString().slice(0, 10);
  for (const hito of document.querySelectorAll<HTMLElement>('[data-orden]')) {
    if ((hito.dataset.orden ?? '') < hoy) {
      hito.classList.add('hito--hecho');
      const marca = hito.querySelector<HTMLElement>('[data-pasado]');
      if (marca) marca.hidden = false;
    }
  }
</script>

<style>
  .revisado {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 1rem 0 0;
    padding: 0.3rem 0.8rem;
    border-radius: 99px;
    background: var(--verde-tinte);
    font-weight: 700;
    font-size: 0.95rem;
  }

  .revisado :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }

  .calendario {
    padding-block: 2rem 4rem;
    max-width: 52rem;
  }

  .calendario__leyenda {
    padding: 1rem 1.2rem;
    border-radius: var(--radio);
    background: var(--blanco);
    border: 1px solid var(--linea);
    margin-bottom: 2rem;
  }

  .calendario__leyenda-titulo {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .calendario__leyenda ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.4rem;
    font-size: 0.97rem;
  }

  .estado {
    display: inline-block;
    margin-right: 0.4rem;
    padding: 0 0.55rem;
    border-radius: 99px;
    font: 700 0.82rem/1.6 var(--letra-titulos);
    white-space: nowrap;
    vertical-align: 0.1em;
  }

  .estado--confirmado {
    background: var(--verde-tinte);
  }

  .estado--previsto {
    background: var(--amarillo-tinte);
  }

  .estado--sin-confirmar {
    background: var(--coral-tinte);
  }

  .linea {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1.6rem;
    border-left: 4px solid var(--linea);
  }

  .hito {
    position: relative;
    padding: 1rem 1.2rem 1.1rem;
    margin-bottom: 1.25rem;
    border-radius: var(--radio);
    background: var(--blanco);
    border: 1px solid var(--linea);
    box-shadow: var(--sombra-suave);
  }

  .hito::before {
    content: '';
    position: absolute;
    left: calc(-1.6rem - 12px);
    top: 1.25rem;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 4px solid var(--crema);
    background: var(--azul);
  }

  .hito--previsto::before {
    background: var(--amarillo);
  }

  .hito--sin-confirmar::before {
    background: var(--coral);
  }

  .hito--hecho {
    background: var(--papel);
  }

  .hito--hecho::before {
    background: var(--texto-suave);
  }

  .hito__cuando {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.6rem;
    margin-bottom: 0.3rem;
    font: 700 1rem/1.3 var(--letra-titulos);
    color: var(--morado-texto);
  }

  .hito__pasado {
    font: 400 0.85rem/1.3 var(--letra-texto);
    color: var(--texto-suave);
  }

  .hito__titulo {
    font-size: 1.25rem;
    margin-bottom: 0.4rem;
  }

  .hito__detalle {
    margin-bottom: 0.5rem;
  }

  .hito__fuente {
    margin: 0;
    font-size: 0.92rem;
    color: var(--texto-suave);
    overflow-wrap: anywhere;
  }

  .vigilar {
    margin-top: 3rem;
  }

  .vigilar ul {
    padding-left: 1.3rem;
  }

  .vigilar li {
    margin-bottom: 0.5rem;
  }
</style>
