---
// Ficha de cada material: como la página de un producto, pero a 0 € y sin carrito.
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Migas from '../../components/Migas.astro';
import Icono from '../../components/Icono.astro';
import TarjetaMaterial from '../../components/TarjetaMaterial.astro';
import { ETAPAS, NECESIDADES, SECCIONES, TIPOS } from '../../data/taxonomias';
import { existeArchivo, extension, fecha, fechaISO, pesoArchivo } from '../../lib/formatos';
import { materialesOrdenados, relacionados, type Material } from '../../lib/materiales';
import { ruta } from '../../lib/rutas';

export async function getStaticPaths() {
  const materiales = await materialesOrdenados();
  return materiales.map((material) => ({ params: { id: material.id }, props: { material, materiales } }));
}

interface Props {
  material: Material;
  materiales: Material[];
}

const { material, materiales } = Astro.props;
const d = material.data;
const { Content } = await render(material);
const disponible = existeArchivo(d.archivo);
const peso = pesoArchivo(d.archivo);
const formatoArchivo = extension(d.archivo);
const parecidos = relacionados(material, materiales);
const anio = d.fecha.getFullYear();
const enlacePublico = new URL(ruta(`/material-gratuito/${material.id}/`), Astro.site).toString();
const cita = `«${d.titulo}», ${d.autoria === 'Equipo IdEducando' ? 'IdEducando' : `${d.autoria} para IdEducando`} (${anio}). Licencia ${d.licencia}. ${enlacePublico}`;
---

<Base titulo={d.titulo} descripcion={d.resumen} imagen={d.portada} tipo="article" imagenBuscador={!d.portada}>
  <section class="ficha-cabecera">
    <div class="contenedor">
      <div data-pagefind-ignore>
        <Migas camino={[{ texto: 'Material gratuito', enlace: '/material-gratuito/' }, { texto: d.titulo }]} />
      </div>

      <div class="ficha">
        <div class="ficha__portada">
          {
            d.portada ? (
              <img
                src={ruta(d.portada)}
                alt={d.portada_alt ?? `Portada de «${d.titulo}»`}
                width="1200"
                height="900"
                data-pagefind-meta="image[src]"
              />
            ) : (
              <div class="ficha__sin-portada" aria-hidden="true">
                <Icono nombre="documento" />
              </div>
            )
          }
        </div>

        <div class="ficha__info">
          <p class="ficha__tipo">
            {TIPOS[d.tipo].nombre} · {SECCIONES[d.seccion].nombre}
          </p>
          <h1>
            {d.borrador && <span class="borrador" data-pagefind-ignore>[BORRADOR]</span>}
            {d.titulo}
          </h1>
          <p class="entradilla">{d.resumen}</p>

          <div class="ficha__compra">
            <p class="ficha__precio">
              <span class="ficha__cero">0 €</span>
              <span>Gratis y sin dejar tu correo.</span>
            </p>
            {
              disponible ? (
                <a class="boton boton--descarga ficha__boton" href={ruta(d.archivo!)}>
                  <Icono nombre="descarga" />
                  <span>
                    Descargar gratis{' '}
                    <span class="ficha__peso">
                      ({formatoArchivo}
                      {peso && `, ${peso}`})
                    </span>
                  </span>
                </a>
              ) : (
                <p class="ficha__pronto">
                  <strong>Próximamente.</strong> Estamos preparando este material.
                </p>
              )
            }
          </div>

          <ul class="etiquetas" aria-label="Para quién es">
            {
              d.etapas.map((e) => (
                <li>
                  <a class={`etiqueta etiqueta--${ETAPAS[e].color}`} href={ruta(`/material-gratuito/etapa/${e}/`)}>
                    {ETAPAS[e].nombre}
                  </a>
                </li>
              ))
            }
            {
              d.necesidades.map((n) => (
                <li>
                  <a
                    class={`etiqueta etiqueta--${NECESIDADES[n].color}`}
                    href={ruta(`/material-gratuito/necesidad/${n}/`)}
                  >
                    {NECESIDADES[n].nombre}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <div class="contenedor ficha-cuerpo">
    <article class="prosa ficha-texto">
      <Content />
    </article>

    <aside class="ficha-tecnica" aria-labelledby="titulo-ficha-tecnica">
      <h2 id="titulo-ficha-tecnica">Ficha técnica</h2>
      <dl>
        <div>
          <dt>Para</dt>
          <dd>{SECCIONES[d.seccion].nombre}</dd>
        </div>
        {
          d.etapas.length > 0 && (
            <div>
              <dt>Etapa</dt>
              <dd>{d.etapas.map((e) => ETAPAS[e].nombre).join(' y ')}</dd>
            </div>
          )
        }
        {
          d.edades && (
            <div>
              <dt>Edades</dt>
              <dd>{d.edades}</dd>
            </div>
          )
        }
        {
          d.necesidades.length > 0 && (
            <div>
              <dt>Necesidades</dt>
              <dd>
                <ul>
                  {d.necesidades.map((n) => (
                    <li>
                      <abbr title={NECESIDADES[n].descripcion}>{NECESIDADES[n].nombre}</abbr>
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          )
        }
        <div>
          <dt>Tipo</dt>
          <dd>{TIPOS[d.tipo].nombre}</dd>
        </div>
        <div>
          <dt>Formato</dt>
          <dd>{d.formato}</dd>
        </div>
        {
          d.paginas && (
            <div>
              <dt>Páginas</dt>
              <dd>{d.paginas}</dd>
            </div>
          )
        }
        {
          peso && (
            <div>
              <dt>Peso</dt>
              <dd>{peso}</dd>
            </div>
          )
        }
        {
          d.tiempo && (
            <div>
              <dt>Preparación</dt>
              <dd>{d.tiempo}</dd>
            </div>
          )
        }
        {
          d.necesitas.length > 0 && (
            <div>
              <dt>Necesitas</dt>
              <dd>
                <ul>
                  {d.necesitas.map((n) => (
                    <li>{n}</li>
                  ))}
                </ul>
              </dd>
            </div>
          )
        }
        <div>
          <dt>Autoría</dt>
          <dd>{d.autoria}</dd>
        </div>
        <div>
          <dt>Licencia</dt>
          <dd><a href={ruta('/licencias/')}>{d.licencia}</a></dd>
        </div>
        <div>
          <dt>Publicado</dt>
          <dd><time datetime={fechaISO(d.fecha)}>{fecha(d.fecha)}</time></dd>
        </div>
        {
          d.actualizado && (
            <div>
              <dt>Revisado</dt>
              <dd>
                <time datetime={fechaISO(d.actualizado)}>{fecha(d.actualizado)}</time>
              </dd>
            </div>
          )
        }
      </dl>

      {
        d.fuentes.length > 0 && (
          <>
            <h3>Fuentes</h3>
            <ul class="ficha-tecnica__fuentes">
              {d.fuentes.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
          </>
        )
      }

      <h3>Cómo citarlo</h3>
      <p class="ficha-tecnica__cita">{cita}</p>
    </aside>
  </div>

  {
    parecidos.length > 0 && (
      <section class="seccion seccion--blanca" aria-labelledby="titulo-parecidos" data-pagefind-ignore>
        <div class="contenedor">
          <h2 id="titulo-parecidos">También te puede servir</h2>
          <ul class="rejilla">
            {parecidos.map((m) => (
              <TarjetaMaterial material={m} />
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <div hidden>
    <span data-pagefind-filter={`Para:${SECCIONES[d.seccion].nombre}`}></span>
    <span data-pagefind-filter={`Tipo:${TIPOS[d.tipo].nombre}`}></span>
    {d.etapas.map((e) => <span data-pagefind-filter={`Etapa:${ETAPAS[e].nombre}`} />)}
    {d.necesidades.map((n) => <span data-pagefind-filter={`Necesidad:${NECESIDADES[n].nombre}`} />)}
  </div>
</Base>

<style>
  .ficha-cabecera {
    padding-block: 1.5rem 2.5rem;
    background: var(--papel);
    border-bottom: 1px solid var(--linea);
  }

  .ficha {
    display: grid;
    gap: 1.5rem 2.5rem;
  }

  @media (min-width: 56em) {
    .ficha {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      align-items: center;
    }
  }

  .ficha__portada {
    border-radius: var(--radio);
    overflow: hidden;
    border: 1px solid var(--linea);
    box-shadow: var(--sombra);
    background: var(--amarillo-tinte);
    aspect-ratio: 4 / 3;
  }

  .ficha__portada img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ficha__sin-portada {
    display: grid;
    place-items: center;
    height: 100%;
    color: var(--texto-suave);
  }

  .ficha__sin-portada :global(svg) {
    width: 4rem;
    height: 4rem;
  }

  .ficha__tipo {
    margin-bottom: 0.4rem;
    font: 700 0.9rem/1.3 var(--letra-titulos);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--texto-suave);
  }

  .ficha__info h1 {
    font-size: clamp(1.9rem, 1.4rem + 2.2vw, 2.8rem);
  }

  .ficha__compra {
    margin-block: 1.25rem;
    padding: 1.1rem 1.2rem;
    border-radius: var(--radio);
    background: var(--blanco);
    border: 2px dashed var(--amarillo);
  }

  .ficha__precio {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.8rem;
    margin-bottom: 0.9rem;
  }

  .ficha__cero {
    font: 700 2rem/1 var(--letra-titulos);
    color: var(--verde-texto);
  }

  .ficha__boton {
    width: 100%;
    min-height: 3.4rem;
    font-size: 1.15rem;
  }

  @media (min-width: 30em) {
    .ficha__boton {
      width: auto;
    }
  }

  .ficha__peso {
    font-weight: 400;
    white-space: nowrap;
  }

  .ficha__pronto {
    margin: 0;
  }

  .ficha-cuerpo {
    display: grid;
    gap: 2rem 3rem;
    padding-block: 2.5rem 3.5rem;
  }

  @media (min-width: 60em) {
    .ficha-cuerpo {
      grid-template-columns: minmax(0, 1fr) 20rem;
      align-items: start;
    }
  }

  .ficha-texto > :global(:first-child) {
    margin-top: 0;
  }

  .ficha-tecnica {
    padding: 1.35rem 1.35rem 1.1rem;
    border-radius: var(--radio);
    background: var(--blanco);
    border: 1px solid var(--linea);
    border-top: 6px solid var(--morado);
    box-shadow: var(--sombra-suave);
    font-size: 0.98rem;
  }

  .ficha-tecnica h2 {
    font-size: 1.35rem;
  }

  .ficha-tecnica h3 {
    font-size: 1.05rem;
    margin: 1.4rem 0 0.4rem;
  }

  .ficha-tecnica dl {
    margin: 0;
  }

  .ficha-tecnica dl > div {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 0.5rem;
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--linea);
  }

  .ficha-tecnica dt {
    font-weight: 700;
  }

  .ficha-tecnica dd {
    margin: 0;
  }

  .ficha-tecnica dd ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ficha-tecnica abbr {
    text-decoration: none;
  }

  .ficha-tecnica__fuentes {
    padding-left: 1.1rem;
    font-size: 0.92rem;
    overflow-wrap: anywhere;
  }

  .ficha-tecnica__cita {
    padding: 0.7rem 0.8rem;
    border-radius: var(--radio-pequeno);
    background: var(--crema);
    font-size: 0.9rem;
    overflow-wrap: anywhere;
  }
</style>
