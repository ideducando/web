---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import TarjetaMaterial from '../components/TarjetaMaterial.astro';
import Borrador from '../components/Borrador.astro';
import sitio from '../data/sitio.json';
import { NECESIDADES } from '../data/taxonomias';
import { fecha, fechaISO } from '../lib/formatos';
import { materialesOrdenados, recuento } from '../lib/materiales';
import { ruta } from '../lib/rutas';

const materiales = await materialesOrdenados();
const escaparate = materiales.filter((m) => m.data.seccion === 'aula').slice(0, 4);
const portadas = materiales.filter((m) => m.data.portada && m.data.destacado).slice(0, 3);
const cuentaNecesidades = recuento(materiales, 'necesidades');
const necesidades = Object.entries(NECESIDADES)
  .filter(([clave]) => (cuentaNecesidades.get(clave) ?? 0) > 0)
  .map(([clave, n]) => ({ clave, ...n, cuenta: cuentaNecesidades.get(clave) ?? 0 }));

const consejos = (await getCollection('consejos'))
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime())
  .slice(0, 3);
---

<Base titulo="Inicio" indexable={false}>
  <section class="portada">
    <div class="contenedor portada__rejilla">
      <div class="portada__texto">
        <p class="portada__antetitulo">Material gratuito de PT e Infantil</p>
        <h1 class="lema portada__titulo">{sitio.lema}</h1>
        <p class="entradilla">
          <Borrador />
          Material para docentes de toda España, pensado para la diversidad del aula. Todo a 0 € y sin
          registro: pulsas y se descarga.
        </p>
        <div class="botones">
          <a class="boton boton--principal" href={ruta('/material-gratuito/')}>
            Ver el material gratuito
            <Icono nombre="flecha" />
          </a>
          <a class="boton boton--secundario" href={ruta('/oposiciones/')}>Oposiciones en Murcia</a>
        </div>
      </div>

      <div class="portada__mesa" aria-hidden="true">
        {
          portadas.map((m, i) => (
            <img
              class={`portada__hoja portada__hoja--${i + 1}`}
              src={ruta(m.data.portada!)}
              alt=""
              width="1200"
              height="900"
              loading={i === 0 ? 'eager' : 'lazy'}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="seccion distintos" aria-labelledby="titulo-distintos">
    <div class="contenedor">
      <h2 id="titulo-distintos"><span class="subrayado">Así es nuestro material</span></h2>
      <ul class="rejilla distintos__lista">
        <li class="posit posit--amarillo">
          <Icono nombre="corazon" clase="distintos__icono" />
          <h3>Gratis de verdad</h3>
          <p>No pedimos tu correo ni que te registres. Pulsas y se descarga.</p>
        </li>
        <li class="posit posit--verde">
          <Icono nombre="lista" clase="distintos__icono" />
          <h3>Con ficha técnica</h3>
          <p>Cada material dice para qué edad y qué necesidades sirve, en qué se basa y cuándo lo revisamos.</p>
        </li>
        <li class="posit posit--morado">
          <Icono nombre="documento" clase="distintos__icono" />
          <h3>PDF accesibles</h3>
          <p>Letra muy legible y documentos preparados para lectores de pantalla.</p>
        </li>
        <li class="posit posit--coral">
          <Icono nombre="manos" clase="distintos__icono" />
          <h3>Para toda la clase</h3>
          <p>
            Diseñados con el Diseño Universal para el Aprendizaje (DUA) y con ideas para adaptarlos a cada
            alumno o alumna.
          </p>
        </li>
      </ul>
    </div>
  </section>

  <section class="seccion seccion--blanca" aria-labelledby="titulo-escaparate">
    <div class="contenedor">
      <div class="cabecera-seccion">
        <h2 id="titulo-escaparate">Para tu aula</h2>
        <a class="flecha" href={ruta('/material-gratuito/')}>Ver todo el catálogo</a>
      </div>
      <ul class="rejilla">
        {escaparate.map((m) => <TarjetaMaterial material={m} />)}
      </ul>
    </div>
  </section>

  <section class="seccion" aria-labelledby="titulo-necesidades">
    <div class="contenedor">
      <h2 id="titulo-necesidades"><span class="subrayado">Busca por necesidad</span></h2>
      <p class="entradilla">
        Cada material indica para qué necesidades sirve. Empieza por la que tienes delante este curso.
      </p>
      <ul class="rejilla necesidades">
        {
          necesidades.map((n) => (
            <li class={`posit posit--${n.color} necesidad`}>
              <h3>
                <a class="enlace-tarjeta" href={ruta(`/material-gratuito/necesidad/${n.clave}/`)}>
                  {n.nombre}
                </a>
              </h3>
              <p>{n.descripcion}</p>
              <p class="necesidad__cuenta">{n.cuenta === 1 ? '1 material' : `${n.cuenta} materiales`}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="seccion oposiciones-bloque" aria-labelledby="titulo-oposiciones">
    <div class="contenedor oposiciones-bloque__rejilla">
      <div>
        <p class="portada__antetitulo">Para opositar en la Región de Murcia</p>
        <h2 id="titulo-oposiciones">Oposiciones de Maestros: PT e Infantil</h2>
        <p>
          Guías gratuitas escritas con el Boletín Oficial de la Región de Murcia (BORM) delante. Cada dato
          lleva su fuente y cada previsión dice que lo es.
        </p>
        <div class="botones">
          <a class="boton boton--principal" href={ruta('/oposiciones/')}>Empieza aquí</a>
          <a class="boton boton--secundario" href={ruta('/oposiciones/calendario/')}>
            <Icono nombre="calendario" />
            Calendario
          </a>
        </div>
      </div>
      <dl class="cifras">
        <div>
          <dt>Plazas de Maestros en 2026</dt>
          <dd>1.607</dd>
        </div>
        <div>
          <dt>De Pedagogía Terapéutica</dt>
          <dd>288</dd>
        </div>
        <div>
          <dt>De Educación Infantil</dt>
          <dd>398</dd>
        </div>
        <div>
          <dt>Páginas máximas de la programación</dt>
          <dd>70</dd>
        </div>
      </dl>
      <p class="cifras__fuente">
        Fuente: <a href="https://www.borm.es/services/boletin/ano/2026/numero/18/pdf">BORM nº 18, de 23/01/2026</a>.
      </p>
    </div>
  </section>

  {
    consejos.length > 0 && (
      <section class="seccion seccion--blanca" aria-labelledby="titulo-consejos">
        <div class="contenedor">
          <div class="cabecera-seccion">
            <h2 id="titulo-consejos">Consejos</h2>
            <a class="flecha" href={ruta('/consejos/')}>
              Ver todos los consejos
            </a>
          </div>
          <ul class="rejilla rejilla--anchas">
            {consejos.map((c) => (
              <li class={`posit ${c.data.seccion === 'oposiciones' ? 'posit--morado' : 'posit--verde'}`}>
                <p class="consejo__fecha">
                  <time datetime={fechaISO(c.data.fecha)}>{fecha(c.data.fecha)}</time>
                </p>
                <h3>
                  <a class="enlace-tarjeta" href={ruta(`/consejos/${c.id}/`)}>
                    {c.data.titulo}
                  </a>
                </h3>
                <p>{c.data.resumen}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="seccion" aria-labelledby="titulo-nosotras">
    <div class="contenedor nosotras">
      <h2 id="titulo-nosotras" class="lema">¿Quién hay detrás?</h2>
      <p class="entradilla">
        <Borrador />
        Un equipo pequeño de la Región de Murcia: maestras especialistas en Pedagogía Terapéutica y alguien que
        se ocupa de la parte digital. Hacemos el material que nos habría gustado encontrar.
      </p>
      <a class="boton boton--secundario" href={ruta('/quienes-somos/')}>Conócenos</a>
    </div>
  </section>
</Base>

<style>
  .portada {
    position: relative;
    overflow: hidden;
    padding-block: 2.5rem 3rem;
    background:
      radial-gradient(circle at 92% 12%, var(--amarillo-tinte) 0 9rem, transparent 9.1rem),
      radial-gradient(circle at 4% 96%, var(--azul-tinte) 0 7rem, transparent 7.1rem),
      var(--crema);
  }

  @media (min-width: 56em) {
    .portada {
      padding-block: 4.5rem 5rem;
    }
  }

  .portada__rejilla {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 56em) {
    .portada__rejilla {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    }
  }

  .portada__antetitulo {
    margin-bottom: 0.6rem;
    font: 700 0.95rem/1.3 var(--letra-titulos);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--morado-texto);
  }

  .portada__titulo {
    font-size: clamp(2.2rem, 1.5rem + 3.6vw, 3.9rem);
    line-height: 1.1;
    margin-bottom: 0.5em;
  }

  .portada .entradilla {
    margin-bottom: 1.6rem;
  }

  .portada__mesa {
    position: relative;
    min-height: 15rem;
    aspect-ratio: 5 / 4;
    max-width: min(34rem, 92%);
    width: 100%;
    margin-inline: auto;
  }

  .portada__hoja {
    position: absolute;
    width: 72%;
    height: auto;
    border-radius: 0.8rem;
    border: 6px solid var(--blanco);
    box-shadow: var(--sombra);
  }

  .portada__hoja--1 {
    left: 0;
    top: 6%;
    transform: rotate(-5deg);
    z-index: 3;
  }

  .portada__hoja--2 {
    right: 0;
    top: 0;
    transform: rotate(4deg);
    z-index: 2;
  }

  .portada__hoja--3 {
    right: 6%;
    bottom: 0;
    transform: rotate(-1deg);
    z-index: 1;
  }

  .distintos__lista {
    margin-top: 1.5rem;
  }

  .distintos__lista :global(.distintos__icono) {
    width: 2.2rem;
    height: 2.2rem;
    color: var(--marino);
  }

  .necesidades {
    margin-top: 1.5rem;
  }

  .necesidad p {
    margin: 0;
    font-size: 0.98rem;
  }

  .necesidad__cuenta {
    margin-top: auto !important;
    font-weight: 700;
    color: var(--texto-suave);
  }

  .oposiciones-bloque {
    background: var(--morado-tinte);
    border-block: 1px solid #dcc9ea;
  }

  .oposiciones-bloque__rejilla {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem 3rem;
    align-items: center;
  }

  @media (min-width: 56em) {
    .oposiciones-bloque__rejilla {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    }
  }

  .cifras {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
    margin: 0;
  }

  .cifras > div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    padding: 1rem;
    border-radius: var(--radio);
    background: var(--blanco);
    box-shadow: var(--sombra-suave);
  }

  .cifras dd {
    margin: 0;
    font: 700 clamp(2rem, 1.6rem + 1.5vw, 2.7rem) / 1 var(--letra-titulos);
    color: var(--morado-texto);
  }

  .cifras dt {
    margin-top: 0.3rem;
    font-size: 0.95rem;
    line-height: 1.3;
  }

  .cifras__fuente {
    margin: 0;
    font-size: 0.92rem;
  }

  @media (min-width: 56em) {
    .cifras__fuente {
      grid-column: 2;
    }
  }

  .cifras__fuente a,
  .oposiciones-bloque a:not(.boton) {
    color: var(--marino);
  }

  .consejo__fecha {
    margin: 0;
    font-size: 0.92rem;
    color: var(--texto-suave);
  }

  .nosotras {
    text-align: center;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
  }

  .nosotras h2 {
    font-size: clamp(1.8rem, 1.4rem + 1.6vw, 2.5rem);
  }
</style>
