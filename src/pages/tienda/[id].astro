---
// Ficha de un producto de la tienda, como en cualquier tienda: la galería a un lado y, al otro, qué es,
// en qué punto está y el botón para escribirnos. Todavía no está a la venta (José, 04/11/2026).
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Migas from '../../components/Migas.astro';
import Icono from '../../components/Icono.astro';
import Galeria from '../../components/Galeria.astro';
import TarjetaTienda from '../../components/TarjetaTienda.astro';
import TarjetaMaterial from '../../components/TarjetaMaterial.astro';
import sitio from '../../data/sitio.json';
import { ESTADOS_TIENDA, PUBLICOS, TIPOS_TIENDA } from '../../data/taxonomias';
import { fecha, fechaISO } from '../../lib/formatos';
import { enlaceContacto, fotosDe, productosOrdenados, type Producto } from '../../lib/tienda';
import { ruta } from '../../lib/rutas';

export async function getStaticPaths() {
  const productos = await productosOrdenados();
  return productos.map((producto) => ({ params: { id: producto.id }, props: { producto, productos } }));
}

interface Props {
  producto: Producto;
  productos: Producto[];
}

const { producto, productos } = Astro.props;
const d = producto.data;
const { Content } = await render(producto);
const fotos = fotosDe(producto);
const estado = ESTADOS_TIENDA[d.estado];
const bloqueadas = fotos.filter((f) => f.bloqueada).length;
const nitidas = fotos.length - bloqueadas;
const notaGaleria =
  bloqueadas > 0
    ? `${nitidas === 1 ? 'La portada se ve entera' : `${nitidas} fotos se ven enteras`} y ${
        bloqueadas === 1 ? 'una página va bloqueada' : `${bloqueadas} páginas van bloqueadas`
      } hasta que salga a la venta.`
    : '';

const relacionado = d.relacionado
  ? (await getCollection('materiales')).find((m) => m.id === d.relacionado && !m.data.borrador)
  : undefined;
if (d.relacionado && !relacionado) {
  throw new Error(`La ficha de la tienda «${producto.id}» enlaza con un material que no existe: ${d.relacionado}`);
}

// «Docentes y familias», «Docentes, familias y opositoras».
const nombres = d.para.map((p, i) => (i === 0 ? PUBLICOS[p].nombre : PUBLICOS[p].nombre.toLowerCase()));
const paraQuien = nombres.length > 1 ? `${nombres.slice(0, -1).join(', ')} y ${nombres.at(-1)}` : nombres[0];

// Otros productos: primero los del mismo tipo.
const otros = [
  ...productos.filter((p) => p.id !== producto.id && p.data.tipo === d.tipo),
  ...productos.filter((p) => p.id !== producto.id && p.data.tipo !== d.tipo),
].slice(0, 3);

// Las redes no enseñan SVG: si la portada es una ilustración, se comparte la imagen general de la web.
const imagenRedes = d.portada.endsWith('.svg') ? undefined : d.portada;
---

<Base titulo={d.titulo} descripcion={d.resumen} imagen={imagenRedes} tipo="article">
  <section class="ficha-cabecera">
    <div class="contenedor">
      <div data-pagefind-ignore>
        <Migas camino={[{ texto: 'Tienda', enlace: '/tienda/' }, { texto: d.titulo }]} />
      </div>

      <div class="ficha">
        <div class="ficha__galeria">
          <Galeria fotos={fotos} titulo={d.titulo} />
          {notaGaleria && <p class="ficha__nota-galeria">{notaGaleria}</p>}
        </div>

        <div class="ficha__info">
          <p class="ficha__tipo">{TIPOS_TIENDA[d.tipo].nombre} · Tienda</p>
          <h1>{d.titulo}</h1>
          <p class="entradilla">{d.resumen}</p>

          <div class="bloqueo">
            <p class="bloqueo__titulo">
              <Icono nombre="candado" />
              <span><strong>Bloqueado.</strong> Todavía no está a la venta.</span>
            </p>
            <p>
              Escríbenos y te contamos qué tenemos, en qué punto está y cuándo saldrá. Lo que nos pidáis nos ayuda a
              decidir qué terminamos primero.
            </p>
            <a class="boton boton--principal bloqueo__boton" href={enlaceContacto(d.titulo)}>
              <Icono nombre="correo" />
              Ponte en contacto con nosotros
            </a>
            <p class="bloqueo__nota">
              Se abre tu programa de correo con el mensaje empezado. Si no se abre, escríbenos a{' '}
              <a href={`mailto:${sitio.correo}`}>{sitio.correo}</a>.
            </p>
          </div>

          <p class={`estado-tienda estado-tienda--${estado.color}`}>
            <strong>{estado.nombre}.</strong>
            {' '}{estado.descripcion}
          </p>

          {
            d.gratis && (
              <p class="ficha__gratis">
                <Icono nombre="corazon" />
                <span>
                  {d.gratis}{' '}
                  {relacionado ? (
                    <a href={ruta(`/material-gratuito/${relacionado.id}/`)}>Ver «{relacionado.data.titulo.split(/:\s/)[0]}»</a>
                  ) : (
                    <a href={ruta('/quienes-somos/#gratis-siempre')}>Por qué</a>
                  )}
                </span>
              </p>
            )
          }

          <ul class="etiquetas" aria-label="Para quién es">
            {d.para.map((p) => <li class={`etiqueta etiqueta--${PUBLICOS[p].color}`}>{PUBLICOS[p].nombre}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <div class="contenedor ficha-cuerpo">
    <article class="prosa ficha-texto">
      <Content />

      <h2>Qué incluirá</h2>
      <ul>
        {d.incluye.map((i) => <li>{i}</li>)}
      </ul>

      <h2>Cómo se podrá conseguir</h2>
      <ul>
        {d.formatos.map((f) => <li>{f}</li>)}
      </ul>
    </article>

    <aside class="ficha-tecnica" aria-labelledby="titulo-ficha-tecnica">
      <h2 id="titulo-ficha-tecnica">Ficha técnica</h2>
      <dl>
        <div>
          <dt>Tipo</dt>
          <dd>{TIPOS_TIENDA[d.tipo].nombre}</dd>
        </div>
        <div>
          <dt>Para</dt>
          <dd>{paraQuien}</dd>
        </div>
        {
          d.edades && (
            <div>
              <dt>Edades</dt>
              <dd>{d.edades}</dd>
            </div>
          )
        }
        {
          d.paginas && (
            <div>
              <dt>{d.solo_muestra ? 'Páginas previstas' : 'Páginas'}</dt>
              <dd>{d.paginas}</dd>
            </div>
          )
        }
        <div>
          <dt>Estado</dt>
          <dd>{estado.nombre}</dd>
        </div>
        <div>
          <dt>Precio</dt>
          <dd>Todavía sin precio: no está a la venta</dd>
        </div>
        <div>
          <dt>Derechos</dt>
          <dd><a href={ruta('/licencias/')}>Todos los derechos reservados</a></dd>
        </div>
        <div>
          <dt>Actualizado</dt>
          <dd><time datetime={fechaISO(d.actualizado ?? d.fecha)}>{fecha(d.actualizado ?? d.fecha)}</time></dd>
        </div>
      </dl>
    </aside>
  </div>

  {
    relacionado && (
      <section class="seccion" aria-labelledby="titulo-mientras" data-pagefind-ignore>
        <div class="contenedor">
          <h2 id="titulo-mientras">Gratis, mientras tanto</h2>
          <ul class="rejilla rejilla--una">
            <TarjetaMaterial material={relacionado} />
          </ul>
        </div>
      </section>
    )
  }

  {
    otros.length > 0 && (
      <section class="seccion seccion--blanca" aria-labelledby="titulo-otros" data-pagefind-ignore>
        <div class="contenedor">
          <div class="cabecera-seccion">
            <h2 id="titulo-otros">También en la tienda</h2>
            <a class="flecha" href={ruta('/tienda/')}>
              Ver toda la tienda
            </a>
          </div>
          <ul class="rejilla">
            {otros.map((p) => (
              <TarjetaTienda producto={p} />
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <div hidden>
    <span data-pagefind-filter="Para:Tienda"></span>
    <span data-pagefind-filter={`Tipo:${TIPOS_TIENDA[d.tipo].nombre}`}></span>
  </div>
</Base>

<style>
  .ficha-cabecera {
    padding-block: 1.5rem 2.5rem;
    background: var(--papel);
    border-bottom: 1px solid var(--linea);
  }

  .ficha {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem 2.5rem;
  }

  @media (min-width: 56em) {
    .ficha {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  .ficha__nota-galeria {
    margin: 0.35rem 0 0;
    font-size: 0.95rem;
    text-align: center;
    color: var(--texto-suave);
  }

  .ficha__tipo {
    margin-bottom: 0.4rem;
    font: 700 0.9rem/1.3 var(--letra-titulos);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--texto-suave);
  }

  .ficha__info h1 {
    font-size: clamp(1.9rem, 1.4rem + 2.2vw, 2.8rem);
  }

  .bloqueo {
    margin-block: 1.25rem;
    padding: 1.1rem 1.2rem;
    border-radius: var(--radio);
    background: var(--blanco);
    border: 2px dashed var(--coral);
  }

  .bloqueo > p {
    margin: 0 0 0.8rem;
  }

  .bloqueo__titulo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.1rem;
  }

  .bloqueo__titulo :global(svg) {
    flex: none;
    width: 2rem;
    height: 2rem;
    color: var(--coral-texto);
  }

  .bloqueo__boton {
    width: 100%;
    min-height: 3.4rem;
    font-size: 1.1rem;
  }

  @media (min-width: 30em) {
    .bloqueo__boton {
      width: auto;
    }
  }

  .bloqueo .bloqueo__nota {
    margin: 0.8rem 0 0;
    font-size: 0.92rem;
    color: var(--texto-suave);
    overflow-wrap: anywhere;
  }

  .estado-tienda {
    margin-block: 0 1rem;
    padding: 0.7rem 0.9rem;
    border-radius: var(--radio-pequeno);
    background: var(--amarillo-tinte);
    font-size: 0.98rem;
  }

  .estado-tienda--verde {
    background: var(--verde-tinte);
  }

  .estado-tienda--azul {
    background: var(--azul-tinte);
  }

  .ficha__gratis {
    display: flex;
    gap: 0.5rem;
    margin-block: 0 1rem;
    font-size: 0.98rem;
  }

  .ficha__gratis :global(svg) {
    flex: none;
    width: 1.4rem;
    height: 1.4rem;
    color: var(--coral-texto);
  }

  .ficha-cuerpo {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem 3rem;
    padding-block: 2.5rem 3.5rem;
  }

  @media (min-width: 60em) {
    .ficha-cuerpo {
      grid-template-columns: minmax(0, 1fr) 20rem;
      align-items: start;
    }
  }

  .ficha-texto > :global(:first-child) {
    margin-top: 0;
  }

  .ficha-tecnica {
    padding: 1.35rem 1.35rem 1.1rem;
    border-radius: var(--radio);
    background: var(--blanco);
    border: 1px solid var(--linea);
    border-top: 6px solid var(--coral);
    box-shadow: var(--sombra-suave);
    font-size: 0.98rem;
  }

  .ficha-tecnica h2 {
    font-size: 1.35rem;
  }

  .ficha-tecnica dl {
    margin: 0;
  }

  .ficha-tecnica dl > div {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 0.5rem;
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--linea);
  }

  .ficha-tecnica dt {
    font-weight: 700;
  }

  .ficha-tecnica dd {
    margin: 0;
  }

  .rejilla--una {
    max-width: 22rem;
  }
</style>
