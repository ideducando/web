---
// La mochila de descargas: los materiales elegidos, todos a 0 €, y el formulario con el correo (y el nombre, opcional).
// Con sitio.json en modo «correo», la función de Netlify netlify/functions/mochila.mjs manda los enlaces al correo
// con Brevo; si Brevo no puede, la página enseña la descarga en pantalla. En modo «demostracion» no se envía
// ningún dato y la página enseña la descarga directamente.
// Los enlaces «Descargarlo todo junto» de los correos traen aquí ?descargar=id1,id2 y la página abre la descarga.
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
import Icono from '../components/Icono.astro';
import sitio from '../data/sitio.json';
import { TIPOS } from '../data/taxonomias';
import { bytesArchivo, existeArchivo, extension, pesoArchivo } from '../lib/formatos';
import { materialesOrdenados } from '../lib/materiales';
import { ruta } from '../lib/rutas';

// Catálogo para la mochila: solo lo que de verdad se puede descargar.
const catalogo = (await materialesOrdenados())
  .filter((m) => existeArchivo(m.data.archivo))
  .map((m) => ({
    id: m.id,
    titulo: m.data.titulo,
    tipo: TIPOS[m.data.tipo].nombre,
    enlace: ruta(`/material-gratuito/${m.id}/`),
    archivo: ruta(m.data.archivo!),
    bytes: bytesArchivo(m.data.archivo),
    portada: m.data.portada ? ruta(m.data.portada) : '',
    detalle: [extension(m.data.archivo), pesoArchivo(m.data.archivo), m.data.paginas && `${m.data.paginas} páginas`]
      .filter(Boolean)
      .join(', '),
  }));

const demostracion = sitio.descargas.modo !== 'correo' || !sitio.descargas.envio;
---

<Base
  titulo="Mi mochila"
  descripcion={
    demostracion
      ? 'Los materiales que has elegido, todos gratis. Déjanos tu correo y descárgalos.'
      : 'Los materiales que has elegido, todos gratis. Déjanos tu correo y te los mandamos.'
  }
  indexable={false}
>
  <Intro
    titulo="Mi mochila"
    entradilla={
      demostracion
        ? 'Aquí tienes los materiales que has elegido. Todos cuestan 0 €: déjanos tu correo y descárgalos.'
        : 'Aquí tienes los materiales que has elegido. Todos cuestan 0 €: déjanos tu correo y te mandamos los enlaces para descargarlos.'
    }
    camino={[{ texto: 'Mi mochila' }]}
  />

  <div class="contenedor mochila" data-mochila>
    <script type="application/json" data-mochila-catalogo set:html={JSON.stringify(catalogo)} />

    <section class="mochila__vacia" data-mochila-vacia hidden aria-labelledby="titulo-vacia">
      <Icono nombre="mochila" clase="mochila__icono-grande" />
      <h2 id="titulo-vacia" tabindex="-1">Tu mochila está vacía</h2>
      <p>
        En el catálogo, pulsa «Añadir a mi mochila» en cada material que quieras, sin entrar en él o desde su ficha.
        Puedes llevarte varios a la vez.
      </p>
      <a class="boton boton--principal" href={ruta('/material-gratuito/')}>
        Ver el material gratuito
        <Icono nombre="flecha" />
      </a>
    </section>

    <div class="mochila__rejilla" data-mochila-llena hidden>
      <section class="mochila__lista" aria-labelledby="titulo-lista">
        <h2 id="titulo-lista">Lo que has elegido</h2>
        <ul class="mochila__materiales" data-mochila-materiales></ul>
        <p class="mochila__total">
          <span data-mochila-resumen></span>
          <span class="mochila__cero">Total: 0 €</span>
        </p>
        <p><a class="flecha" href={ruta('/material-gratuito/')}>Añadir más material</a></p>
      </section>

      <section class="mochila__datos" aria-labelledby="titulo-datos">
        <h2 id="titulo-datos">{demostracion ? 'Tus datos para descargar' : '¿Adónde te lo mandamos?'}</h2>
        {
          demostracion && (
            <p class="mochila__demo">
              Vista previa: este formulario todavía no guarda ningún dato. Al
              pulsar el botón verás las descargas, como las verá quien lo use cuando esté activo.
            </p>
          )
        }
        <form
          class="formulario"
          data-mochila-formulario
          data-modo={demostracion ? 'demostracion' : 'correo'}
          data-envio={demostracion ? '' : sitio.descargas.envio}
        >
          <div class="campo">
            <label for="mochila-nombre">Tu nombre (opcional)</label>
            <input id="mochila-nombre" name="nombre" type="text" autocomplete="given-name" maxlength="80" />
          </div>
          <div class="campo">
            <label for="mochila-correo">Tu correo electrónico</label>
            <input
              id="mochila-correo"
              name="correo"
              type="email"
              autocomplete="email"
              inputmode="email"
              required
              maxlength="120"
              aria-describedby="mochila-correo-ayuda"
            />
            <p id="mochila-correo-ayuda" class="campo__ayuda">
              {
                demostracion
                  ? 'Escríbelo bien: si quieres el boletín, te llegará aquí.'
                  : 'Escríbelo bien: te mandamos ahí los enlaces para descargar.'
              }
            </p>
          </div>

          <div class="trampa" aria-hidden="true">
            <label for="mochila-web">Deja este campo vacío</label>
            <input id="mochila-web" name="sitio_web" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div class="casilla">
            <input id="mochila-privacidad" name="privacidad" type="checkbox" value="si" required />
            <label for="mochila-privacidad">
              He leído y acepto la <a href={ruta('/privacidad/')}>política de privacidad</a>.
            </label>
          </div>
          <div class="casilla">
            <input id="mochila-boletin" name="boletin" type="checkbox" value="si" />
            <label for="mochila-boletin">
              Quiero recibir el boletín de IdEducando, con material nuevo y novedades de oposiciones. Lo confirmaré
              desde mi correo y me puedo dar de baja cuando quiera.
            </label>
          </div>

          <details class="mochila__info">
            <summary>Información básica sobre tus datos</summary>
            <dl>
              <div>
                <dt>Responsable</dt>
                <dd>El titular de la web. Sus datos están en el <a href={ruta('/aviso-legal/')}>aviso legal</a>.</dd>
              </div>
              <div>
                <dt>Para qué</dt>
                <dd>Mandarte el material a tu correo y, solo si marcas la casilla y lo confirmas, el boletín.</dd>
              </div>
              <div>
                <dt>Base legal</dt>
                <dd>Tu consentimiento, que puedes retirar cuando quieras.</dd>
              </div>
              <div>
                <dt>Con quién</dt>
                <dd>
                  No vendemos ni cedemos tus datos. Los correos los envía Brevo, por encargo nuestro, con servidores en
                  la Unión Europea.
                </dd>
              </div>
              <div>
                <dt>Tus derechos</dt>
                <dd>
                  Ver, corregir o borrar tus datos, entre otros, escribiendo a{' '}
                  <a href={`mailto:${sitio.correo}`}>{sitio.correo}</a>. Más información en la{' '}
                  <a href={ruta('/privacidad/')}>política de privacidad</a>.
                </dd>
              </div>
            </dl>
          </details>

          <button class="boton boton--descarga mochila__boton" type="submit">
            <Icono nombre={demostracion ? 'descarga' : 'correo'} />
            {demostracion ? 'Descargar gratis' : 'Enviar a mi correo'}
          </button>
          <p class="campo__error" data-mochila-error role="alert" hidden></p>
        </form>
      </section>
    </div>

    <section class="mochila__listo" data-mochila-enviado hidden aria-labelledby="titulo-enviado">
      <Icono nombre="correo" clase="mochila__icono-grande" />
      <h2 id="titulo-enviado" tabindex="-1">¡Hecho<span data-mochila-saludo></span>! Revisa tu correo</h2>
      <p>
        Te hemos mandado los enlaces para descargar a <strong class="mochila__correo" data-mochila-correo></strong>.
        Suele llegar en menos de un minuto.
      </p>
      <p>
        ¿No lo ves? Mira en Promociones o en Spam, y guarda {sitio.correo} en tus contactos para que los siguientes
        lleguen bien.
      </p>
      <p class="mochila__aviso" data-mochila-boletin hidden></p>
      <div class="botones mochila__opciones">
        <button type="button" class="boton boton--secundario" data-mochila-corregir>Me he equivocado de correo</button>
        <a class="boton boton--secundario" href={ruta('/material-gratuito/')}>Ver más material</a>
      </div>
    </section>

    <section class="mochila__listo" data-mochila-listo hidden aria-labelledby="titulo-listo">
      <Icono nombre="ok" clase="mochila__icono-grande" />
      <h2 id="titulo-listo" tabindex="-1" data-mochila-titulo-listo>
        ¡Listo<span data-mochila-saludo></span>! Aquí tienes tu material
      </h2>
      <p class="mochila__aviso" data-mochila-aviso hidden></p>
      <div class="mochila__todo" data-mochila-todo hidden>
        <p>Descárgalo todo de una vez o elige uno a uno.</p>
        <div class="botones mochila__opciones">
          <button type="button" class="boton boton--descarga" data-mochila-zip>
            <Icono nombre="descarga" />
            <span>
              Todo junto en un ZIP <span class="mochila__detalle-boton" data-mochila-zip-peso></span>
            </span>
          </button>
          <button type="button" class="boton boton--secundario" data-mochila-separado>
            <Icono nombre="descarga" />
            Todos por separado
          </button>
        </div>
        <progress class="mochila__progreso" data-mochila-progreso aria-label="Preparando el ZIP" hidden></progress>
        <p class="mochila__estado" data-mochila-estado role="status"></p>
        <a class="flecha" data-mochila-zip-enlace href="" download="ideducando-material.zip" hidden>
          Guardar el ZIP
        </a>
        <p class="mochila__ayuda">
          Un ZIP es un solo archivo con todos los PDF dentro. En el móvil se abre desde la app de archivos.
        </p>
        <h3 class="mochila__uno-a-uno">O uno a uno</h3>
      </div>
      <p data-mochila-solo-uno>Pulsa el botón para guardarlo en tu ordenador o en tu móvil.</p>
      <ul class="mochila__descargas" data-mochila-descargas></ul>
      {
        demostracion && (
          <p class="mochila__demo">
            Vista previa: no se ha guardado ningún dato.
          </p>
        )
      }
      <a class="boton boton--secundario" href={ruta('/material-gratuito/')}>Ver más material</a>
    </section>

    <template data-plantilla-material>
      <li class="mochila__material">
        <img class="mochila__portada" src="" alt="" width="1200" height="900" loading="lazy" />
        <div class="mochila__texto">
          <p class="mochila__tipo" data-tipo></p>
          <p class="mochila__titulo"><a data-titulo href=""></a></p>
          <p class="mochila__detalle" data-detalle></p>
        </div>
        <p class="mochila__precio">0 €</p>
        <button type="button" class="mochila__quitar" data-quitar>
          <Icono nombre="papelera" />
          <span class="solo-lectores" data-quitar-texto>Quitar</span>
        </button>
      </li>
    </template>

    <template data-plantilla-descarga>
      <li>
        <a class="boton boton--descarga mochila__descarga" href="" download>
          <Icono nombre="descarga" />
          <span><span data-titulo></span> <span class="mochila__detalle-boton" data-detalle></span></span>
        </a>
      </li>
    </template>

    <noscript>
      <p class="mochila__sin-js">
        La mochila necesita JavaScript activado en el navegador. Si no puedes activarlo, escríbenos a{' '}
        <a href={`mailto:${sitio.correo}`}>{sitio.correo}</a> y te enviamos el material.
      </p>
    </noscript>
  </div>
</Base>

<script>
  import { alCambiarMochila, anadirAMochila, leerMochila, quitarDeMochila, vaciarMochila } from '../scripts/mochila';
  import { crearZip } from '../scripts/zip';
  import { formatoPeso } from '../lib/peso';

  interface Material {
    id: string;
    titulo: string;
    tipo: string;
    enlace: string;
    archivo: string;
    bytes: number;
    portada: string;
    detalle: string;
  }

  const raiz = document.querySelector<HTMLElement>('[data-mochila]')!;
  const catalogo: Material[] = JSON.parse(raiz.querySelector('[data-mochila-catalogo]')!.textContent ?? '[]');
  const porId = new Map(catalogo.map((m) => [m.id, m]));
  const $ = <T extends HTMLElement>(selector: string) => raiz.querySelector<T>(selector)!;

  const vacia = $('[data-mochila-vacia]');
  const llena = $('[data-mochila-llena]');
  const lista = $('[data-mochila-materiales]');
  const resumen = $('[data-mochila-resumen]');
  const formulario = $<HTMLFormElement>('[data-mochila-formulario]');
  const error = $('[data-mochila-error]');
  const listo = $('[data-mochila-listo]');
  const enviado = $('[data-mochila-enviado]');
  const plantillaMaterial = $<HTMLTemplateElement>('[data-plantilla-material]');
  const plantillaDescarga = $<HTMLTemplateElement>('[data-plantilla-descarga]');

  let terminado = false;
  // Lo que se ha pedido al pulsar «Descargar gratis»: la mochila se vacía, pero esto sigue para las descargas.
  let descargados: Material[] = [];
  let ocupado = false;

  const elegidos = () => leerMochila().map((id) => porId.get(id)).filter((m): m is Material => Boolean(m));
  const nombreArchivo = (m: Material) => m.archivo.split('/').pop() || `${m.id}.pdf`;
  const pausa = (ms: number) => new Promise((seguir) => setTimeout(seguir, ms));

  const todo = $('[data-mochila-todo]');
  const botonZip = $<HTMLButtonElement>('[data-mochila-zip]');
  const botonSeparado = $<HTMLButtonElement>('[data-mochila-separado]');
  const progreso = $<HTMLProgressElement>('[data-mochila-progreso]');
  const estado = $('[data-mochila-estado]');
  const enlaceZip = $<HTMLAnchorElement>('[data-mochila-zip-enlace]');

  /** Mientras se prepara una descarga, los dos botones esperan (sin perder el foco). */
  function esperar(si: boolean) {
    ocupado = si;
    for (const boton of [botonZip, botonSeparado]) boton.setAttribute('aria-disabled', String(si));
    progreso.hidden = !si || progreso.max <= 1;
  }

  function descargar(href: string, nombre: string) {
    const enlace = document.createElement('a');
    enlace.href = href;
    enlace.download = nombre;
    enlace.hidden = true;
    document.body.append(enlace);
    enlace.click();
    enlace.remove();
  }

  // Todo junto: se piden los PDF a la propia web, se meten en un ZIP y se guarda.
  botonZip.addEventListener('click', async () => {
    if (ocupado) return;
    enlaceZip.hidden = true;
    progreso.max = descargados.length;
    progreso.value = 0;
    esperar(true);
    estado.textContent = `Preparando el ZIP con ${descargados.length} PDF…`;
    try {
      const archivos = [];
      for (const m of descargados) {
        const respuesta = await fetch(m.archivo);
        if (!respuesta.ok) throw new Error(`Respuesta ${respuesta.status}`);
        archivos.push({ nombre: nombreArchivo(m), datos: await respuesta.arrayBuffer() });
        progreso.value += 1;
      }
      if (enlaceZip.href.startsWith('blob:')) URL.revokeObjectURL(enlaceZip.href);
      enlaceZip.href = URL.createObjectURL(crearZip(archivos));
      enlaceZip.click();
      enlaceZip.hidden = false;
      estado.textContent = 'Hecho: el ZIP se guarda en tu carpeta de descargas. Si no empieza, pulsa «Guardar el ZIP».';
    } catch {
      estado.textContent = 'No hemos podido preparar el ZIP. Prueba con «Todos por separado» o descárgalos uno a uno.';
    } finally {
      esperar(false);
    }
  });

  // Por separado: cada PDF se descarga por su lado, con un respiro entre uno y otro.
  botonSeparado.addEventListener('click', async () => {
    if (ocupado) return;
    enlaceZip.hidden = true;
    progreso.max = 1;
    esperar(true);
    estado.textContent = `Descargando ${descargados.length} PDF. Si tu navegador pregunta si permites varias descargas, pulsa «Permitir».`;
    for (const m of descargados) {
      descargar(m.archivo, nombreArchivo(m));
      await pausa(800);
    }
    estado.textContent = 'Hecho: búscalos en tu carpeta de descargas. Si falta alguno, descárgalo con su botón de abajo.';
    esperar(false);
  });

  function pintar() {
    if (terminado) return;
    const materiales = elegidos();
    vacia.hidden = materiales.length > 0;
    llena.hidden = materiales.length === 0;
    lista.replaceChildren(
      ...materiales.map((m) => {
        const fila = plantillaMaterial.content.firstElementChild!.cloneNode(true) as HTMLElement;
        const portada = fila.querySelector<HTMLImageElement>('img')!;
        if (m.portada) portada.src = m.portada;
        else portada.remove();
        fila.querySelector('[data-tipo]')!.textContent = m.tipo;
        const titulo = fila.querySelector<HTMLAnchorElement>('[data-titulo]')!;
        titulo.textContent = m.titulo;
        titulo.href = m.enlace;
        fila.querySelector('[data-detalle]')!.textContent = m.detalle;
        fila.querySelector('[data-quitar-texto]')!.textContent = `Quitar «${m.titulo}» de la mochila`;
        fila.querySelector('[data-quitar]')!.addEventListener('click', () => {
          quitarDeMochila(m.id);
          // Tras quitar uno, el foco va al título de la lista para no perderse.
          raiz.querySelector<HTMLElement>('#titulo-lista')?.setAttribute('tabindex', '-1');
          raiz.querySelector<HTMLElement>(materiales.length > 1 ? '#titulo-lista' : '#titulo-vacia')?.focus();
        });
        return fila;
      }),
    );
    resumen.textContent = materiales.length === 1 ? '1 material' : `${materiales.length} materiales`;
  }

  // Lo que contesta la función de Netlify (netlify/functions/mochila.mjs).
  interface Respuesta {
    enviado: boolean;
    motivo?: string;
    boletin?: 'no' | 'enviado' | 'ya' | 'pendiente' | 'error';
  }

  const ERRORES: Record<string, string> = {
    correo: 'Revisa tu correo: parece que le falta algo, como la @ o el final (.es, .com…).',
    privacidad: 'Para mandarte el material necesitamos que aceptes la política de privacidad.',
    materiales: 'No encontramos esos materiales. Vuelve al catálogo y añádelos otra vez.',
    prisa: 'Has hecho varios intentos seguidos. Espera unos minutos y vuelve a probar.',
    red: 'No hemos podido enviar tus datos. Prueba otra vez en un momento o escríbenos a hola@ideducando.es.',
  };

  const BOLETIN: Record<string, string> = {
    enviado: 'Te llega también otro correo para confirmar el boletín. Hasta que pulses «Sí, quiero el boletín», no te apuntamos.',
    ya: 'Tu correo ya estaba apuntado al boletín: no tienes que hacer nada más.',
    pendiente: 'Hoy ya te mandamos el correo para confirmar el boletín: búscalo y pulsa «Sí, quiero el boletín».',
    error: 'No hemos podido mandarte el correo para confirmar el boletín. Si lo quieres, vuelve a marcar la casilla otro día.',
  };

  /** En modo demostración no se envía nada (null). En modo correo, contesta la función o salta un error. */
  async function enviar(datos: FormData): Promise<Respuesta | null> {
    const envio = formulario.dataset.envio;
    if (formulario.dataset.modo !== 'correo' || !envio) return null;
    let respuesta: Response;
    try {
      respuesta = await fetch(envio, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams([...datos.entries()].map(([k, v]) => [k, String(v)])).toString(),
      });
    } catch {
      throw new Error('red');
    }
    if (respuesta.status === 429) throw new Error('prisa');
    const cuerpo = await respuesta.json().catch(() => ({}));
    if (!respuesta.ok) throw new Error(cuerpo.error in ERRORES ? cuerpo.error : 'red');
    return cuerpo as Respuesta;
  }

  /** Pantalla «Revisa tu correo». Guarda lo pedido por si hay que corregir la dirección. */
  let pedidos: Material[] = [];
  function mostrarEnviado(correo: string, nombre: string, boletin = 'no') {
    terminado = true;
    for (const saludo of raiz.querySelectorAll('[data-mochila-saludo]')) saludo.textContent = nombre ? `, ${nombre}` : '';
    $('[data-mochila-correo]').textContent = correo;
    const aviso = $('[data-mochila-boletin]');
    aviso.textContent = BOLETIN[boletin] ?? '';
    aviso.hidden = !aviso.textContent;
    llena.hidden = true;
    vacia.hidden = true;
    listo.hidden = true;
    enviado.hidden = false;
    vaciarMochila();
    raiz.querySelector<HTMLElement>('#titulo-enviado')?.focus();
  }

  // «Me he equivocado de correo»: vuelve el formulario con lo mismo en la mochila.
  $('[data-mochila-corregir]').addEventListener('click', () => {
    for (const m of pedidos) anadirAMochila(m.id);
    terminado = false;
    enviado.hidden = true;
    formulario.querySelector<HTMLButtonElement>('button[type="submit"]')!.disabled = false;
    pintar();
    const campo = formulario.querySelector<HTMLInputElement>('#mochila-correo')!;
    campo.focus();
    campo.select();
  });

  formulario.addEventListener('submit', async (evento) => {
    evento.preventDefault();
    error.hidden = true;
    const datos = new FormData(formulario);
    if (String(datos.get('sitio_web') ?? '').trim()) return; // Lo rellenó un robot.
    const materiales = elegidos();
    if (!materiales.length) return;
    datos.delete('sitio_web');
    datos.set('materiales', materiales.map((m) => m.id).join(', '));

    const boton = formulario.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    boton.disabled = true;
    let respuesta: Respuesta | null;
    try {
      respuesta = await enviar(datos);
    } catch (fallo) {
      error.textContent = ERRORES[(fallo as Error).message] ?? ERRORES.red;
      error.hidden = false;
      boton.disabled = false;
      return;
    }

    const nombre = String(datos.get('nombre') ?? '').trim();
    pedidos = materiales;
    if (respuesta?.enviado) {
      mostrarEnviado(String(datos.get('correo') ?? '').trim(), nombre, respuesta.boletin);
      return;
    }
    // Sin correo (modo demostración, o Brevo no ha podido): la descarga, en pantalla.
    const aviso = !respuesta
      ? ''
      : respuesta.motivo === 'repetido'
        ? 'Hoy ya te hemos mandado este correo varias veces, así que aquí tienes el material para descargarlo.'
        : 'Ahora mismo no podemos mandarte el correo, así que aquí tienes el material para descargarlo.';
    mostrarDescargas(materiales, nombre, aviso);
    vaciarMochila();
  });

  /** Pantalla de descarga: ZIP, todos por separado o uno a uno. */
  function mostrarDescargas(materiales: Material[], nombre: string, aviso = '', desdeCorreo = false) {
    terminado = true;
    descargados = materiales;
    const varios = materiales.length > 1;
    todo.hidden = !varios;
    $('[data-mochila-solo-uno]').hidden = varios;
    $('[data-mochila-zip-peso]').textContent = `(${formatoPeso(materiales.reduce((suma, m) => suma + m.bytes, 0))})`;
    for (const saludo of raiz.querySelectorAll('[data-mochila-saludo]')) saludo.textContent = nombre ? `, ${nombre}` : '';
    if (desdeCorreo) $('[data-mochila-titulo-listo]').textContent = 'Aquí tienes tu material';
    const avisoListo = $('[data-mochila-aviso]');
    avisoListo.textContent = aviso;
    avisoListo.hidden = !aviso;
    $('[data-mochila-descargas]').replaceChildren(
      ...materiales.map((m) => {
        const fila = plantillaDescarga.content.firstElementChild!.cloneNode(true) as HTMLElement;
        const enlace = fila.querySelector<HTMLAnchorElement>('a')!;
        enlace.href = m.archivo;
        // Con varios, lo principal es «Todo junto» o «Todos por separado»; los de uno en uno van en segundo plano.
        if (varios) enlace.classList.replace('boton--descarga', 'boton--secundario');
        fila.querySelector('[data-titulo]')!.textContent = m.titulo;
        fila.querySelector('[data-detalle]')!.textContent = `(${m.detalle})`;
        return fila;
      }),
    );
    llena.hidden = true;
    vacia.hidden = true;
    enviado.hidden = true;
    listo.hidden = false;
    // Al llegar desde el correo, la página empieza aquí y el foco no se mueve.
    if (!desdeCorreo) raiz.querySelector<HTMLElement>('#titulo-listo')?.focus();
  }

  // El botón «Descargarlo todo junto» del correo trae ?descargar=id1,id2: se abre la descarga sin formulario.
  const delCorreo = (new URLSearchParams(location.search).get('descargar') ?? '')
    .split(',')
    .map((id) => porId.get(id.trim()))
    .filter((m): m is Material => Boolean(m));
  if (delCorreo.length) mostrarDescargas(delCorreo, '', '', true);
  else pintar();
  alCambiarMochila(pintar);
</script>

