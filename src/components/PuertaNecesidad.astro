---
// Puerta de entrada de cada necesidad (B-008, paso 1, aprobado por José el 24/11/2026): por dónde empezar
// en casa y en clase, y una ruta de materiales en orden. Va encima del material en tres barras plegadas,
// para que el material siga saliendo casi arriba (José, 25/11/2026). Las apps y a quién acudir en Murcia
// van debajo del material, en PuertaRecursos. Los datos están en src/data/puertas-necesidad.json y los
// revisan Lilia y Marta. Si un paso o la ruta nombran un material que no existe, la web no se construye.
import type { Material } from '../lib/materiales';
import { ruta } from '../lib/rutas';

interface Paso {
  texto: string;
  material?: string;
}
interface Entrada {
  titulo: string;
  pasos: Paso[];
}
export interface App {
  nombre: string;
  quien: string;
  para: string;
  precio: string;
  datos: string;
  url: string;
  comprobado: string;
}
export interface Lugar {
  nombre: string;
  que: string;
  url?: string | null;
  nota?: string;
  comprobado: string;
}
export interface Puerta {
  familia: Entrada;
  seno: Entrada;
  ruta: string[];
  pocos?: string;
  apps: App[];
  murcia: Lugar[];
}

interface Props {
  puerta: Puerta;
  materiales: Material[];
}

const { puerta, materiales } = Astro.props;
const porId = new Map(materiales.map((m) => [m.id, m]));
const titulo = (id: string) => {
  const m = porId.get(id);
  if (!m) throw new Error(`Puerta de necesidad: no existe el material «${id}» (src/data/puertas-necesidad.json).`);
  return m.data.titulo;
};
const entradas = [
  { clase: 'familia', ayuda: 'Por dónde empezar en casa', ...puerta.familia },
  { clase: 'seno', ayuda: 'Por dónde empezar en clase', ...puerta.seno },
];
const pasosRuta = puerta.ruta.length === 1 ? '1 material' : `${puerta.ruta.length} materiales`;
---

<div class="puerta" data-pagefind-ignore>
  {
    entradas.map((e) => (
      <details class={`panel panel--${e.clase}`}>
        <summary>
          <span class="panel__texto">
            <span class="panel__titulo">{e.titulo}</span>
            <span class="panel__ayuda">{e.ayuda}</span>
          </span>
          <span class="panel__signo" aria-hidden="true" />
        </summary>
        <ol class="panel__lista">
          {e.pasos.map((p) => (
            <li>
              {p.texto}
              {p.material && (
                <span class="panel__material">
                  Material:{' '}
                  <a href={ruta(`/material-gratuito/${p.material}/`)}>{titulo(p.material)}</a>
                </span>
              )}
            </li>
          ))}
        </ol>
      </details>
    ))
  }
  <details class="panel panel--ruta">
    <summary>
      <span class="panel__texto">
        <span class="panel__titulo">Una ruta de {pasosRuta}</span>
        <span class="panel__ayuda">En el orden recomendado para empezar</span>
      </span>
      <span class="panel__signo" aria-hidden="true" />
    </summary>
    <ol class="panel__lista">
      {
        puerta.ruta.map((id) => (
          <li>
            <a href={ruta(`/material-gratuito/${id}/`)}>{titulo(id)}</a>
          </li>
        ))
      }
    </ol>
    {puerta.pocos && <p class="panel__pocos">{puerta.pocos}</p>}
  </details>
</div>

<style>
  .puerta {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.6rem;
    align-items: start;
    margin-bottom: 1.75rem;
  }

  @media (min-width: 60em) {
    .puerta {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .panel {
    border-radius: var(--radio-pequeno);
    border-left: 0.35rem solid var(--color);
    background: var(--tinte);
  }

  .panel--familia {
    --color: var(--coral);
    --tinte: var(--coral-tinte);
  }

  .panel--seno {
    --color: var(--verde);
    --tinte: var(--verde-tinte);
  }

  .panel--ruta {
    --color: var(--morado);
    --tinte: var(--morado-tinte);
  }

  .panel summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 3rem;
    padding: 0.55rem 0.9rem;
    cursor: pointer;
    list-style: none;
  }

  .panel summary::-webkit-details-marker {
    display: none;
  }

  .panel summary:focus-visible {
    outline: 3px solid var(--marino);
    outline-offset: 2px;
    border-radius: var(--radio-pequeno);
  }

  .panel__texto {
    display: grid;
    gap: 0.05rem;
  }

  .panel__titulo {
    font: 700 1rem/1.25 var(--letra-titulos);
  }

  .panel__ayuda {
    font-size: 0.88rem;
    color: var(--texto-suave);
  }

  /* Flecha que gira al abrir */
  .panel__signo {
    flex: none;
    width: 0.6rem;
    height: 0.6rem;
    margin-right: 0.2rem;
    margin-top: -0.25rem;
    border-right: 0.16rem solid var(--marino);
    border-bottom: 0.16rem solid var(--marino);
    transform: rotate(45deg);
    transition: transform 0.15s ease;
  }

  .panel[open] .panel__signo {
    margin-top: 0.25rem;
    transform: rotate(-135deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .panel__signo {
      transition: none;
    }
  }

  .panel__lista {
    margin: 0;
    padding: 0.1rem 1rem 0.9rem 2.1rem;
  }

  .panel__lista li {
    margin-bottom: 0.5rem;
  }

  .panel__material {
    display: block;
    margin-top: 0.15rem;
    font-weight: 700;
  }

  .panel a {
    color: var(--marino);
  }

  .panel__pocos {
    margin: 0;
    padding: 0 1rem 0.9rem;
    font-style: italic;
  }
</style>
