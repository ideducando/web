---
// A quién acudir en la Región de Murcia, de cada necesidad (B-008, paso 1). Sale desde el 25/11/2026 solo
// con servicios públicos: la web no hace publicidad de nadie, así que las asociaciones se guardan en
// src/data/puertas-necesidad.json con "tipo": "asociacion" y no se enseñan, igual que no salen apps.
// Con "mostrar_murcia": false se esconde entero. Va debajo del material para que este salga casi arriba.
import { fecha } from '../lib/formatos';
import type { Puerta } from './PuertaNecesidad.astro';

interface Props {
  puerta: Puerta;
  comprobado: string;
}

const { puerta, comprobado } = Astro.props;
const publicos = puerta.murcia.filter((l) => l.tipo !== 'asociacion');
---

{
  publicos.length > 0 && (
    <section class="recursos-puerta" aria-labelledby="titulo-recursos" data-pagefind-ignore>
      <h2 id="titulo-recursos">A quién acudir en la Región de Murcia</h2>
      <p class="recursos-puerta__entrada">Servicios públicos de la Región para el alumnado y sus familias.</p>
      <ul>
        {publicos.map((l) => (
          <li>
            {l.url ? (
              <a href={l.url} rel="noopener">
                {l.nombre}
              </a>
            ) : (
              <strong>{l.nombre}</strong>
            )}
            . {l.que}
            {l.nota && <span class="recursos-puerta__detalle">{l.nota}</span>}
          </li>
        ))}
      </ul>
      <p class="recursos-puerta__fecha">
        Enlaces comprobados el <time datetime={comprobado}>{fecha(new Date(comprobado))}</time>. No ganamos nada
        por recomendar estos servicios. Si alguno cambia, escríbenos.
      </p>
    </section>
  )
}

<style>
  .recursos-puerta {
    margin-top: 2.5rem;
    padding: 1.4rem 1.4rem 1.1rem;
    border-radius: var(--radio);
    background: var(--papel);
    box-shadow: var(--sombra-suave);
  }

  .recursos-puerta h2 {
    margin: 0 0 0.4rem;
    font-size: 1.3rem;
  }

  .recursos-puerta__entrada {
    margin: 0 0 1rem;
  }

  .recursos-puerta ul {
    margin: 0;
    padding-left: 1.1rem;
  }

  .recursos-puerta li {
    margin-bottom: 0.6rem;
  }

  .recursos-puerta__detalle {
    display: block;
    font-size: 0.92rem;
    color: var(--texto-suave);
  }

  .recursos-puerta__fecha {
    margin: 0.75rem 0 0;
    font-size: 0.92rem;
    color: var(--texto-suave);
  }
</style>
