---
// Ventana de bienvenida. Sale una sola vez en cada navegador: se recuerda en el almacenamiento
// local, sin cookies. Se cierra con la X, con el botón «Entrar» o con la tecla Esc.
// Para volver a verla al revisar la web, añade ?bienvenida a la dirección.
import Icono from './Icono.astro';
import sitio from '../data/sitio.json';
import { ruta } from '../lib/rutas';
---

<dialog
  class="bienvenida"
  aria-labelledby="bienvenida-titulo"
  aria-describedby="bienvenida-texto"
  data-bienvenida
  data-pagefind-ignore
>
  <form method="dialog" class="bienvenida__caja">
    <button class="bienvenida__cerrar" value="cerrar" aria-label="Cerrar la bienvenida">
      <Icono nombre="cerrar" />
    </button>
    <img class="bienvenida__simbolo" src={ruta('/favicon.svg')} alt="" width="72" height="72" />
    <p class="bienvenida__antetitulo">Te damos la bienvenida a {sitio.nombre}</p>
    <h2 id="bienvenida-titulo" class="lema bienvenida__titulo">{sitio.bienvenida.titulo}</h2>
    <p id="bienvenida-texto" class="bienvenida__texto">{sitio.bienvenida.texto}</p>
    <div class="botones bienvenida__botones">
      <a class="boton boton--principal" href={ruta('/material-gratuito/')}>
        Ver el material
        <Icono nombre="flecha" />
      </a>
      <button class="boton boton--secundario" value="entrar">Entrar en la web</button>
    </div>
  </form>
</dialog>

<script>
  const CLAVE = 'ideducando-bienvenida-vista';
  const dialogo = document.querySelector<HTMLDialogElement>('[data-bienvenida]');

  let vista = false;
  try {
    vista = localStorage.getItem(CLAVE) === '1';
  } catch {
    // Sin almacenamiento local (modo privado estricto): se enseña y no se recuerda.
  }
  const forzar = new URLSearchParams(location.search).has('bienvenida');

  if (dialogo && typeof dialogo.showModal === 'function' && (!vista || forzar)) {
    dialogo.showModal();
    try {
      localStorage.setItem(CLAVE, '1');
    } catch {
      // Nada que hacer: la próxima vez saldrá otra vez.
    }
    // Un toque fuera de la caja también la cierra, como en cualquier aviso del móvil.
    dialogo.addEventListener('click', (evento) => {
      if (evento.target === dialogo) dialogo.close();
    });
  }
</script>

<style>
  .bienvenida {
    width: min(30rem, calc(100% - 2rem));
    max-height: calc(100% - 2rem);
    padding: 0;
    border: 0;
    border-radius: 1.25rem;
    background: var(--papel);
    color: var(--marino);
    box-shadow: 0 20px 60px -15px rgb(30 43 85 / 0.45);
  }

  .bienvenida::backdrop {
    background: rgb(30 43 85 / 0.55);
  }

  .bienvenida__caja {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    padding: 2rem 1.5rem 1.6rem;
    text-align: center;
    border-top: 8px solid transparent;
    border-image: linear-gradient(
        90deg,
        var(--azul) 0 20%,
        var(--verde) 20% 40%,
        var(--amarillo) 40% 60%,
        var(--coral) 60% 80%,
        var(--morado) 80% 100%
      )
      1;
  }

  .bienvenida__cerrar {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 2px solid var(--marino);
    border-radius: 999px;
    background: var(--blanco);
    color: var(--marino);
    cursor: pointer;
  }

  .bienvenida__cerrar:hover {
    background: var(--amarillo-tinte);
  }

  .bienvenida__cerrar :global(svg) {
    width: 1.3rem;
    height: 1.3rem;
  }

  .bienvenida__simbolo {
    width: 4.5rem;
    height: 4.5rem;
  }

  .bienvenida__antetitulo {
    margin: 0.3rem 0 0;
    font: 700 0.9rem/1.3 var(--letra-titulos);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--morado-texto);
  }

  .bienvenida__titulo {
    margin: 0.2rem 0 0.3rem;
    font-size: clamp(1.9rem, 1.5rem + 2vw, 2.4rem);
    line-height: 1.1;
  }

  .bienvenida__texto {
    margin: 0 0 1rem;
    font-size: 1.1rem;
    line-height: 1.5;
  }

  .bienvenida__botones {
    justify-content: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .bienvenida[open] {
      animation: aparecer 0.25s ease-out;
    }

    @keyframes aparecer {
      from {
        opacity: 0;
        transform: translateY(0.75rem) scale(0.98);
      }
    }
  }
</style>
