---
import { Image } from 'astro:assets';
import logo from '../assets/logo-pie.png';
import sitio from '../data/sitio.json';
import { ETAPAS, NECESIDADES } from '../data/taxonomias';
import { ruta } from '../lib/rutas';

const anio = new Date().getFullYear();
const necesidadesPie = (['tea', 'tdah', 'tdl', 'toda-la-clase'] as const).map((clave) => ({
  clave,
  nombre: NECESIDADES[clave].nombre,
}));
---

<footer class="pie">
  <div class="pie__rayos" aria-hidden="true"></div>
  <div class="contenedor pie__rejilla">
    <div class="pie__marca">
      <Image src={logo} width={400} alt="IdEducando" loading="lazy" />
      <p class="lema pie__lema">{sitio.lema}.</p>
      <p>
        Material gratuito para docentes de toda España, sin anuncios.
      </p>
    </div>

    <nav class="pie__columna" aria-labelledby="pie-material">
      <h2 id="pie-material">Material gratuito</h2>
      <ul>
        <li><a href={ruta('/material-gratuito/')}>Todo el catálogo</a></li>
        {
          Object.entries(ETAPAS).map(([clave, etapa]) => (
            <li>
              <a href={ruta(`/material-gratuito/etapa/${clave}/`)}>{etapa.nombre}</a>
            </li>
          ))
        }
        {
          necesidadesPie.map((n) => (
            <li>
              <a href={ruta(`/material-gratuito/necesidad/${n.clave}/`)}>{n.nombre}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class="pie__columna" aria-labelledby="pie-oposiciones">
      <h2 id="pie-oposiciones">Oposiciones</h2>
      <ul>
        <li><a href={ruta('/oposiciones/')}>Oposiciones en Murcia</a></li>
        <li><a href={ruta('/oposiciones/calendario/')}>Calendario</a></li>
        <li><a href={ruta('/oposiciones/programacion/')}>Revisa tu programación</a></li>
        <li><a href={ruta('/consejos/')}>Consejos</a></li>
      </ul>
    </nav>

    <nav class="pie__columna" aria-labelledby="pie-ideducando">
      <h2 id="pie-ideducando">IdEducando</h2>
      <ul>
        <li><a href={ruta('/quienes-somos/')}>Quiénes somos</a></li>
        <li><a href={ruta('/como-hacemos-los-materiales/')}>Cómo hacemos los materiales</a></li>
        <li><a href={ruta('/contacto/')}>Contacto</a></li>
        <li><a href={`mailto:${sitio.correo}`}>{sitio.correo}</a></li>
      </ul>
    </nav>
  </div>

  <div class="contenedor pie__legal">
    <p>
      © {anio} IdEducando. Esta web no usa cookies de seguimiento ni analítica de terceros.
    </p>
    <ul>
      <li><a href={ruta('/aviso-legal/')}>Aviso legal</a></li>
      <li><a href={ruta('/privacidad/')}>Privacidad</a></li>
      <li><a href={ruta('/accesibilidad/')}>Accesibilidad</a></li>
      <li><a href={ruta('/licencias/')}>Licencias y créditos</a></li>
    </ul>
  </div>
</footer>

<style>
  .pie {
    margin-top: auto;
    background: var(--marino);
    color: var(--crema);
  }

  .pie__rayos {
    height: 6px;
    background: linear-gradient(
      90deg,
      var(--azul) 0 20%,
      var(--verde) 20% 40%,
      var(--amarillo) 40% 60%,
      var(--coral) 60% 80%,
      var(--morado) 80% 100%
    );
  }

  .pie a {
    color: var(--amarillo);
  }

  .pie a:hover {
    color: var(--blanco);
  }

  .pie :focus-visible {
    outline-color: var(--amarillo);
  }

  .pie__rejilla {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    padding-block: 2.75rem 2rem;
  }

  @media (min-width: 40em) {
    .pie__rejilla {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64em) {
    .pie__rejilla {
      grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(0, 1fr));
    }
  }

  .pie__marca img {
    display: block;
    width: 13rem;
    height: auto;
    margin-bottom: 1rem;
  }

  .pie__lema {
    font-size: 1.25rem;
    line-height: 1.35;
    margin-bottom: 0.6rem;
  }

  .pie__columna h2 {
    font-size: 1.05rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--crema);
    margin-bottom: 0.8rem;
  }

  .pie__columna ul,
  .pie__legal ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .pie__columna li {
    margin-bottom: 0.45rem;
  }

  .pie__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1.25rem 2rem;
    border-top: 1px solid rgb(255 246 230 / 0.2);
    font-size: 0.95rem;
  }

  .pie__legal p {
    margin: 0;
  }

  .pie__legal ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }
</style>
