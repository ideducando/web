---
import { Image } from 'astro:assets';
import logo from '../assets/logo-cabecera.png';
import Icono from './Icono.astro';
import { esActual, ruta } from '../lib/rutas';

const actual = Astro.url.pathname;

const menu = [
  { texto: 'Inicio', enlace: '/' },
  { texto: 'Material gratuito', enlace: '/material-gratuito/' },
  { texto: 'Oposiciones', enlace: '/oposiciones/' },
  { texto: 'Consejos', enlace: '/consejos/' },
  { texto: 'Quiénes somos', enlace: '/quienes-somos/' },
  { texto: 'Contacto', enlace: '/contacto/' },
];
---

<header class="cabecera">
  <div class="cabecera__rayos" aria-hidden="true"></div>
  <div class="contenedor cabecera__barra">
    <a class="cabecera__logo" href={ruta('/')}>
      <Image
        src={logo}
        width={400}
        alt="IdEducando, ir a la página de inicio"
        loading="eager"
        fetchpriority="high"
      />
    </a>

    <div class="cabecera__acciones">
      <a class="cabecera__buscar" href={ruta('/buscar/')} aria-current={esActual(actual, '/buscar/')}>
        <Icono nombre="buscar" />
        <span>Buscar</span>
      </a>
      <button
        class="cabecera__menu"
        type="button"
        aria-expanded="false"
        aria-controls="menu-principal"
        data-boton-menu
      >
        <Icono nombre="menu" clase="icono-abrir" />
        <Icono nombre="cerrar" clase="icono-cerrar" />
        <span>Menú</span>
      </button>
    </div>

    <nav class="cabecera__nav" aria-label="Principal">
      <ul id="menu-principal" class="menu" data-menu>
        {
          menu.map((item) => (
            <li>
              <a href={ruta(item.enlace)} aria-current={esActual(actual, item.enlace)}>
                {item.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const boton = document.querySelector<HTMLButtonElement>('[data-boton-menu]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  if (boton && menu) {
    const cerrar = () => {
      boton.setAttribute('aria-expanded', 'false');
      document.documentElement.classList.remove('menu-abierto');
    };

    boton.addEventListener('click', () => {
      const abierto = boton.getAttribute('aria-expanded') === 'true';
      boton.setAttribute('aria-expanded', String(!abierto));
      document.documentElement.classList.toggle('menu-abierto', !abierto);
      if (!abierto) menu.querySelector<HTMLAnchorElement>('a')?.focus();
    });

    document.addEventListener('keydown', (evento) => {
      if (evento.key === 'Escape' && boton.getAttribute('aria-expanded') === 'true') {
        cerrar();
        boton.focus();
      }
    });

    window.matchMedia('(min-width: 64em)').addEventListener('change', cerrar);
  }
</script>

<style>
  .cabecera {
    position: relative;
    z-index: 20;
    background: var(--papel);
    border-bottom: 1px solid var(--linea);
  }

  .cabecera__rayos {
    height: 6px;
    background: linear-gradient(
      90deg,
      var(--azul) 0 20%,
      var(--verde) 20% 40%,
      var(--amarillo) 40% 60%,
      var(--coral) 60% 80%,
      var(--morado) 80% 100%
    );
  }

  .cabecera__barra {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding-block: 0.65rem;
  }

  .cabecera__logo {
    display: block;
    flex: none;
    border-radius: 0.5rem;
  }

  .cabecera__logo img {
    display: block;
    height: 2.85rem;
    width: auto;
  }

  .cabecera__acciones {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .cabecera__buscar,
  .cabecera__menu {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    padding: 0.4rem 0.8rem;
    border: 2px solid var(--marino);
    border-radius: 999px;
    background: var(--blanco);
    color: var(--marino);
    font: 600 1rem/1 var(--letra-titulos);
    text-decoration: none;
    cursor: pointer;
  }

  .cabecera__buscar:hover,
  .cabecera__menu:hover {
    background: var(--amarillo-tinte);
    color: var(--marino);
  }

  .cabecera__buscar[aria-current] {
    background: var(--amarillo);
  }

  .cabecera__buscar :global(svg),
  .cabecera__menu :global(svg) {
    width: 1.3rem;
    height: 1.3rem;
  }

  .cabecera__menu :global(.icono-cerrar) {
    display: none;
  }

  :global(.menu-abierto) .cabecera__menu :global(.icono-cerrar) {
    display: block;
  }

  :global(.menu-abierto) .cabecera__menu :global(.icono-abrir) {
    display: none;
  }

  /* En móviles estrechos, «Buscar» se queda en icono (el texto sigue ahí para lectores de pantalla). */
  @media (max-width: 29.99em) {
    .cabecera__buscar {
      padding-inline: 0.65rem;
    }

    .cabecera__buscar span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }
  }

  .cabecera__nav {
    flex-basis: 100%;
  }

  .menu {
    list-style: none;
    margin: 0;
    padding: 0.5rem 0 0.25rem;
    display: grid;
    gap: 0.25rem;
  }

  /* Con JavaScript, el menú del móvil se pliega detrás del botón. Sin él, se ve siempre. */
  :global(.js) .menu {
    display: none;
  }

  :global(.js.menu-abierto) .menu {
    display: grid;
  }

  :global(.no-js) .cabecera__menu {
    display: none;
  }

  .menu a {
    display: block;
    padding: 0.7rem 0.9rem;
    border-radius: var(--radio-pequeno);
    color: var(--marino);
    font: 600 1.1rem/1.2 var(--letra-titulos);
    text-decoration: none;
  }

  .menu a:hover {
    background: var(--amarillo-tinte);
  }

  .menu a[aria-current='page'],
  .menu a[aria-current='true'] {
    background: var(--amarillo-tinte);
    box-shadow: inset 4px 0 0 var(--amarillo);
  }

  @media (min-width: 64em) {
    .cabecera__barra {
      flex-wrap: nowrap;
      padding-block: 0.8rem;
    }

    .cabecera__logo img {
      height: 3.4rem;
    }

    .cabecera__nav {
      flex-basis: auto;
      order: 2;
      margin-left: auto;
    }

    .cabecera__acciones {
      order: 3;
    }

    .cabecera__menu {
      display: none;
    }

    .menu,
    :global(.js) .menu {
      display: flex;
      gap: 0.15rem;
      padding: 0;
    }

    .menu a {
      padding: 0.55rem 0.7rem;
      font-size: 1.02rem;
    }

    .menu a[aria-current='page'],
    .menu a[aria-current='true'] {
      box-shadow: inset 0 -4px 0 var(--amarillo);
      background: transparent;
    }

    .menu a:hover {
      background: var(--amarillo-tinte);
    }
  }

  @media (min-width: 64em) and (max-width: 72em) {
    .cabecera__buscar span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }
  }
</style>
