  lista:
    '<path d="M9.5 7h10M9.5 12h10M9.5 17h10"/><path d="M4 7l1.2 1.2L7 6.3M4 12l1.2 1.2L7 11.3M4 17l1.2 1.2L7 16.3"/>',
  libro:
    '<path d="M12 6.5c-2-1.7-5-2.2-8-1.6v13c3-.6 6-.1 8 1.6 2-1.7 5-2.2 8-1.6v-13c-3-.6-6-.1-8 1.6z"/><path d="M12 6.5v13"/>',
  info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v5.5M12 7.6v.4"/>',
  atencion: '<path d="M12 3.5l9 16H3z"/><path d="M12 10v4.5M12 17.2v.3"/>',
  ok: '<circle cx="12" cy="12" r="9"/><path d="M8 12.3l2.7 2.7L16.2 9.5"/>',
  correo: '<rect x="3" y="5.5" width="18" height="13" rx="2.5"/><path d="M3.8 7l8.2 6 8.2-6"/>',
  imprimir:
    '<path d="M7 9V3.5h10V9"/><rect x="3.5" y="9" width="17" height="8" rx="2"/><path d="M7 14.5h10v6H7z"/>',
  reloj: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5.2l3.5 2"/>',
  documento:
    '<path d="M6.5 3h7.5l4.5 4.5V21h-12z"/><path d="M14 3v4.5h4.5M9 12.5h6M9 16h6"/>',
  corazon:
    '<path d="M12 20s-7.5-4.6-7.5-10.1A4.2 4.2 0 0 1 12 7.4a4.2 4.2 0 0 1 7.5 2.5C19.5 15.4 12 20 12 20z"/>',
  bombilla:
