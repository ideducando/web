    | 'menu'
    | 'cerrar'
    | 'buscar'
    | 'descarga'
    | 'flecha'
    | 'calendario'
    | 'lista'
    | 'libro'
    | 'info'
    | 'atencion'
    | 'ok'
    | 'correo'
    | 'imprimir'
    | 'reloj'
    | 'documento'
    | 'corazon'
    | 'bombilla'
    | 'manos';
  clase?: string;
}

const { nombre, clase = '' } = Astro.props;

const trazos: Record<Props['nombre'], string> = {
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  cerrar: '<path d="M6 6l12 12M18 6L6 18"/>',
