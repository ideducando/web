---
// Plantilla común a todas las páginas: cabecera, pie, letras, colores y datos para buscadores.
import '@fontsource/outfit/latin-600.css';
import '@fontsource/outfit/latin-700.css';
import '@fontsource/young-serif/latin-400.css';
import '@fontsource/atkinson-hyperlegible/latin-400.css';
import '@fontsource/atkinson-hyperlegible/latin-400-italic.css';
import '@fontsource/atkinson-hyperlegible/latin-700.css';
import '../styles/global.css';

import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import sitio from '../data/sitio.json';
import { ruta } from '../lib/rutas';

interface Props {
  titulo: string;
  descripcion?: string;
  /** Imagen para compartir en redes, ruta dentro de public/ */
  imagen?: string;
  /** false en páginas que no deben salir en el buscador interno: inicio, listados, 404 y buscar */
  indexable?: boolean;
  tipo?: 'website' | 'article';
  /** Imagen por defecto para los resultados del buscador. Las fichas usan su portada. */
  imagenBuscador?: boolean;
}

const {
  titulo,
  descripcion = sitio.descripcion,
  imagen = '/og-imagen.png',
  indexable = true,
  tipo = 'website',
  imagenBuscador = true,
} = Astro.props;

const esInicio = Astro.url.pathname === ruta('/');
const tituloCompleto = esInicio ? `${sitio.nombre} · ${sitio.subtitulo}` : `${titulo} · ${sitio.nombre}`;
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagenAbsoluta = new URL(ruta(imagen), Astro.site);
---

<!doctype html>
<html lang="es-ES" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
    </script>
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    {sitio.borrador && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonica} />
    <link rel="icon" href={ruta('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={ruta('/favicon.ico')} sizes="32x32" />
    <link rel="apple-touch-icon" href={ruta('/apple-touch-icon.png')} />
    <link rel="sitemap" href={ruta('/sitemap-index.xml')} />
    <meta name="theme-color" content="#FFF6E6" />

    <meta property="og:type" content={tipo} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={sitio.nombre} />
    <meta property="og:title" content={esInicio ? tituloCompleto : titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagenAbsoluta} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="cabeza" />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    {
      sitio.borrador && (
        <div class="aviso-borrador" role="note">
          <div class="contenedor">
            <span class="borrador" data-pagefind-ignore>[BORRADOR]</span>
            {sitio.aviso_borrador}
          </div>
        </div>
      )
    }
    <Cabecera />
    <main id="contenido" tabindex="-1" data-pagefind-body={indexable ? '' : undefined}>
      <slot />
      {indexable && <span hidden data-pagefind-meta="title">{titulo}</span>}
      {indexable && imagenBuscador && <span hidden data-pagefind-meta={`image:${ruta('/apple-touch-icon.png')}`} />}
    </main>
    <Pie />
  </body>
</html>

<style>
  .aviso-borrador {
    background: var(--coral-tinte);
    border-bottom: 1px solid #f3c2b8;
    font-size: 0.95rem;
    line-height: 1.45;
    padding-block: 0.55rem;
  }

  main:focus {
    outline: none;
  }
</style>
